# Served by nginx inside the container. ${BACKEND_URL} is substituted from the
# environment when the container starts (see the Dockerfile), so the same image
# works in compose and in Kubernetes.
#
# Note that only ${BACKEND_URL} is substituted: nginx's own $host, $uri and
# friends are not environment variables, so they survive untouched.

server {
    # 8080, not 80: this image runs as a non-root user, and only root may bind
    # a port below 1024.
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Vite puts a content hash in every asset filename, so a given URL can never
    # change contents and may be cached forever.
    location /assets/ {
        # One complete Cache-Control header rather than nginx's `expires`
        # directive, which emits a Cache-Control of its own and would leave the
        # response carrying two of them.
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html is the one file whose contents change while keeping its name.
    # Caching it would leave browsers loading an old page that references asset
    # files the new build has deleted.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # In development Vite's dev-server proxy forwards /api to the backend. There
    # is no Vite in a container, so nginx takes over the same job. Either way the
    # browser only ever talks to one origin, so CORS never comes into it.
    location /api/ {
        proxy_pass       ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Fail fast rather than holding a browser connection open when the
        # backend is down; the UI already handles the error.
        proxy_connect_timeout 3s;
        proxy_read_timeout    15s;
    }

    # The app keeps its own history stack instead of using URL routes, but a
    # refresh or a deep link should still return the app rather than a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # For the container healthcheck and the Kubernetes probes. Serving static
    # files needs no readiness check beyond "nginx is answering".
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
